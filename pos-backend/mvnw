#!/bin/sh
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.9
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="${MAVEN_HOME}/bin/mvn"
if [ ! -x "$MAVEN_BIN" ]; then
  DISTRIBUTION_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
  ARCHIVE="${TMPDIR:-/tmp}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
  mkdir -p "$MAVEN_HOME" || exit 1
  echo "Downloading Apache Maven ${MAVEN_VERSION}..."
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DISTRIBUTION_URL" -o "$ARCHIVE" || exit 1
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DISTRIBUTION_URL" -O "$ARCHIVE" || exit 1
  else
    echo "curl or wget is required to download Maven." >&2
    exit 1
  fi
  tar -xzf "$ARCHIVE" -C "$MAVEN_HOME" || exit 1
  mv "$MAVEN_HOME/apache-maven-${MAVEN_VERSION}"/* "$MAVEN_HOME"/ || exit 1
  rmdir "$MAVEN_HOME/apache-maven-${MAVEN_VERSION}" 2>/dev/null || true
fi
exec "$MAVEN_BIN" "$@"
